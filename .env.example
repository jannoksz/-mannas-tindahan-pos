# Copy this file to .env and fill in your Supabase project credentials
# (Project Settings → API in your Supabase dashboard)

# ⚠️ Use the SERVICE ROLE key here, not the anon/public key.
#    The backend needs full read/write access and this key must
#    never be exposed to the frontend or committed to git.
SUPABASE_URL=https://supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-key
# Optional — many hosts set this automatically.
# Only needed for local overrides.
# PORT=3000
